{
  "multipart": [
    { "when": { "up": true }, "apply": { "model": "bd:block/calcite_brick_wall_post" } },

    { "when": { "north": true, "up": false }, "apply": { "model": "bd:block/calcite_brick_wall_side", "uvlock": true } },
    { "when": { "east": true, "up": false }, "apply": { "model": "bd:block/calcite_brick_wall_side", "y": 90, "uvlock": true } },
    { "when": { "south": true, "up": false }, "apply": { "model": "bd:block/calcite_brick_wall_side", "y": 180, "uvlock": true } },
    { "when": { "west": true, "up": false }, "apply": { "model": "bd:block/calcite_brick_wall_side", "y": 270, "uvlock": true } },

    { "when": { "north": true, "up": true }, "apply": { "model": "bd:block/calcite_brick_wall_side_tall", "uvlock": true } },
    { "when": { "east": true, "up": true }, "apply": { "model": "bd:block/calcite_brick_wall_side_tall", "y": 90, "uvlock": true } },
    { "when": { "south": true, "up": true }, "apply": { "model": "bd:block/calcite_brick_wall_side_tall", "y": 180, "uvlock": true } },
    { "when": { "west": true, "up": true }, "apply": { "model": "bd:block/calcite_brick_wall_side_tall", "y": 270, "uvlock": true } },

    { "when": { "north": false, "east": true, "south": false, "west": false, "up": false }, "apply": { "model": "bd:block/calcite_brick_wall_side", "y": 90, "uvlock": true } },
    { "when": { "north": false, "east": false, "south": true, "west": false, "up": false }, "apply": { "model": "bd:block/calcite_brick_wall_side", "y": 180, "uvlock": true } },
    { "when": { "north": false, "east": false, "south": false, "west": true, "up": false }, "apply": { "model": "bd:block/calcite_brick_wall_side", "y": 270, "uvlock": true } },
    { "when": { "north": true, "east": false, "south": false, "west": false, "up": false }, "apply": { "model": "bd:block/calcite_brick_wall_side", "uvlock": true } }
  ]
}
