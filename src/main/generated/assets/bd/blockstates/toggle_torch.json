{
  "multipart": [
    {
      "when": { "face": "floor" },
      "apply": { "model": "minecraft:block/torch" }
    },
    {
      "when": { "face": "wall", "facing": "north" },
      "apply": { "model": "minecraft:block/wall_torch", "y": 270 }
    },
    {
      "when": { "face": "wall", "facing": "east" },
      "apply": { "model": "minecraft:block/wall_torch" }
    },
    {
      "when": { "face": "wall", "facing": "south" },
      "apply": { "model": "minecraft:block/wall_torch", "y": 90 }
    },
    {
      "when": { "face": "wall", "facing": "west" },
      "apply": { "model": "minecraft:block/wall_torch", "y": 180 }
    },
    {
      "when": { "face": "ceiling" },
      "apply": { "model": "minecraft:block/torch", "x": 180 }
    }
  ]
}